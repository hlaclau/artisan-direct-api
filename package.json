{
  "name": "artisan-direct-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun dist/index.js",
    "build": "tsc --noEmit && bun build src/index.ts --target bun --outdir dist",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "prepare": "lefthook install",
    "auth:generate": "bunx @better-auth/cli generate --config src/auth.ts --output src/db/schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.11",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.1",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
